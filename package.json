{
  "name": "imgkeep",
  "version": "0.3.0",
  "private": true,
  "description": "Imgkeep Chrome extension, website and tests. The extension itself has no dependencies.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "pretest": "node tests/make-fixtures.mjs",
    "test": "node tests/static-check.mjs && playwright test",
    "check": "node tests/static-check.mjs",
    "fixtures": "node tests/make-fixtures.mjs --force",
    "icons": "python3 scripts/make-icons.py",
    "store": "node store/render.mjs",
    "package": "sh scripts/package.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
