{
  "name": "imgkeep",
  "version": "0.8.0",
  "private": true,
  "description": "Imgkeep Chrome extension, website and tests. The extension itself has no dependencies.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "pretest": "node tests/make-fixtures.mjs",
    "test": "node tests/static-check.mjs && playwright test",
    "check": "node tests/static-check.mjs",
    "fixtures": "node tests/make-fixtures.mjs --force",
    "icons": "python3 scripts/make-icons.py",
    "store": "node store/render.mjs",
    "package": "sh scripts/package.sh",
    "version-css": "node scripts/version-css.mjs",
    "video": "node store/video/render.mjs",
    "guide-shots": "node store/guide-shots.mjs",
    "og": "node store/og.mjs",
    "site-lib": "node scripts/site-lib.mjs",
    "translate": "node scripts/translate.mjs",
    "release": "node scripts/release.mjs",
    "build-firefox": "node scripts/build-firefox.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@playwright/test": "^1.55.0",
    "parse5": "^8.0.1",
    "puppeteer-core": "^25.16.0"
  }
}
