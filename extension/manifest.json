{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Imgkeep",
  "version": "0.6.1",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "homepage_url": "https://imgkeep.app",
  "permissions": ["contextMenus", "downloads", "storage", "offscreen"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
