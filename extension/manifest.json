{
  "manifest_version": 3,
  "name": "Imgkeep — Save image as PNG, JPG, WebP, GIF or PDF",
  "short_name": "Imgkeep",
  "version": "0.5.0",
  "description": "Right-click to save any image as PNG, JPG, WebP, GIF or PDF. Converts WebP and AVIF on your device, into your folder. No tracking.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://imgkeep.app",
  "permissions": ["contextMenus", "downloads", "storage", "offscreen"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
